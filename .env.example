# Enmaa.ai Configuration
# Copy this file to .env and fill in your keys

# Ollama (local AI models) — optional, skip if deploying to cloud
OLLAMA_HOST=http://127.0.0.1:11434

# OpenRouter API — free open-source models (recommended for cloud deployment)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# HuggingFace Inference API (optional)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Anthropic API (Claude models) — optional, needs paid key
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Server
PORT=10000
